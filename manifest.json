{
  "manifest_version": 3,
  "name": "Klipin",
  "version": "1.4.0",
  "description": "Judul → naskah → suara → scene → gambar otomatis di Google Flow → render MP4. Semua dari side panel.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Buka Klipin",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "tabs", "scripting", "clipboardWrite"],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google/*",
    "https://flow.google.com/*",
    "https://*.flow.google.com/*",
    "https://aistudio.google.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://*.googleusercontent.com/*",
    "https://storage.googleapis.com/*",
    "https://api.elevenlabs.io/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "https://api.groq.com/*",
    "https://api.deepseek.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://labs.google/*", "https://flow.google/*", "https://flow.google.com/*", "https://*.flow.google.com/*"],
      "js": ["content/flow.js"],
      "run_at": "document_idle"
    }
  ]
}
